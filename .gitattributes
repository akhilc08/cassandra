# Generated by the daily Actions run, which rewrites them on every scan. A local
# `forward_test.py report` produces a different timestamp, so these collide on
# every rebase. The pipeline's copy is authoritative; keep the incoming version
# rather than stopping to resolve a file that is regenerated minutes later.
data/forward/summary.json   merge=theirs -diff
data/forward/decisions.jsonl merge=union
