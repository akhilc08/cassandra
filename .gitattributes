# Generated by the Actions run, which rewrites summary.json on every scan. A
# local `forward_test.py report` produces a different timestamp, so it collides
# on every rebase. It is derived entirely from decisions.jsonl + scans.jsonl:
# the workflow's commit step regenerates it (`forward_test.py report`) when it
# is the only conflicting path and continues the rebase. -diff keeps the noisy
# regenerated blob out of `git diff` / `git log -p`.
data/forward/summary.json    -diff
# Append-only logs: a rebase that touched both sides keeps the union of lines.
data/forward/decisions.jsonl merge=union
data/forward/scans.jsonl     merge=union
